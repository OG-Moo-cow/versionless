{
  "schemaVersion": 1,
  "id": "versionless",
  "version": "${version}",
  "name": "Versionless",
  "description": "Backward-compatibility bridge for Fabric mods 1.20+ → MC 26.1",
  "authors": ["OG-Moo-cow", "PyreHaven Team"],
  "contact": {
    "homepage": "https://github.com/OG-Moo-cow/versionless",
    "sources": "https://github.com/OG-Moo-cow/versionless",
    "issues": "https://github.com/OG-Moo-cow/versionless/issues"
  },
  "license": "MIT",
  "icon": "assets/versionless/icon.png",
  "environment": "*",
  "entrypoints": {
    "preLaunch": [
      "dev.pyrehaven.versionless.VersionlessPreLaunch"
    ],
    "main": [
      "dev.pyrehaven.versionless.Versionless"
    ]
  },
  "mixins": [],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~26.1",
    "java": ">=25",
    "fabric-api": "*"
  },
  "custom": {
    "versionless:supported_sources": [
      "1.20", "1.20.1", "1.20.2", "1.20.4", "1.20.6",
      "1.21", "1.21.1", "1.21.4", "1.21.5", "1.21.6",
      "1.21.8", "1.21.9", "1.21.10", "1.21.11"
    ]
  }
}
